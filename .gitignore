# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local.txt

# local assistant state
.claude/state/

# local env backups (may contain real keys)
.env*.bak
*.placeholder.bak

# isolated production build output (NEXT_DIST_DIR)
.next-build/

# Duplicate source art — byte-identical to the tracked arc-*-source.png /
# bcon-icon.png, and unreferenced by any import.
/public/ARC Full logo.png
/public/ARC Icon.png
/public/brand logos/

# Stray exports dropped in the repo root
/ChatGPT Image*.png

# Service account and API key files. These are credentials: a leaked GCP service
# account key grants whatever the account can do, and unlike a password it is not
# rotated on login. Never commit one, whatever it is called.
*-key.json
*_key.json
*service-account*.json
*credentials*.json
gcloud-*.json

# Stray SDK installs. The Google Cloud installer defaults its install path to the
# current directory, and answering its prompt with "yes" creates ./yes.
/yes/
google-cloud-sdk/

# Google service account keys. These are private keys; they belong in
# .env.local (or a secret manager), never in the repository.
*.json.key
bcon-arc-*.json
*-service-account*.json
gcp-*.json
