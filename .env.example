# Shared with Next.js (already in .env.local)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# ARC agent behaviour
APPROVAL_GATE=human       # human | auto
VIDEO_MODE=film            # film | ai

# Source API keys — optional; stages stub gracefully if absent
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USER_AGENT=arc-agent/0.1
YOUTUBE_API_KEY=
PRODUCTHUNT_TOKEN=
X_BEARER_TOKEN=

# Publish keys — optional in v0.1; posts stay 'queued' until set
IG_ACCESS_TOKEN=
TIKTOK_TOKEN=
LINKEDIN_TOKEN=
YOUTUBE_OAUTH_TOKEN=

# Edit pipeline
BCON_LOGO_PATH=/path/to/bcon_logo.png   # absolute path on VPS
