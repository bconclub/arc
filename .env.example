# Shared with Next.js (already in .env.local)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# PROXe pipe. WhatsApp send goes through PROXe; dial results and briefs land in ARC.
PROXE_INTENT_BASE=
PROXE_INBOUND_API_KEY=
ARC_INGEST_SECRET=

# ARC agent behaviour
APPROVAL_GATE=human       # human | auto
VIDEO_MODE=film            # film | ai

# Source API keys, optional; stages stub gracefully if absent
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USER_AGENT=arc-agent/0.1
YOUTUBE_API_KEY=
PRODUCTHUNT_TOKEN=
X_BEARER_TOKEN=

# Publish keys, optional in v0.1; posts stay 'queued' until set
IG_ACCESS_TOKEN=
TIKTOK_TOKEN=
LINKEDIN_TOKEN=
YOUTUBE_OAUTH_TOKEN=

# Edit pipeline
BCON_LOGO_PATH=/path/to/bcon_logo.png   # absolute path on VPS

# Meta Ads (Marketing API). A System User token from Business Settings is
# preferred: user tokens expire after about 60 days and the panel then goes
# quietly stale. Needs ads_read only, ARC never writes to the ad account.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000
META_APP_ID=
META_APP_SECRET=

# Google Analytics 4. GA4_PROPERTY_ID is the NUMERIC id from Admin, Property
# Settings, not the G-XXXXXXX measurement id. Authenticate with either the
# service account key JSON or the OAuth trio, not both.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=
