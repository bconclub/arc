# Copy to .env (same folder) and fill in. Never commit .env.

# ARC: same secret the editor desk uses for `tasks.py sync`
ARC_URL=https://arc.bconclub.com
ARC_INGEST_SECRET=
AGENT_NAME=mac-editor

# Where job folders live on the Mac
BRAND_REELS_HOME=~/BrandReels
POLL_SECONDS=30
JOB_TIMEOUT_MIN=150

# Claude Code (logged in on this Mac with the BCON plan). Full path if launchd can't find it.
CLAUDE_BIN=claude
CLAUDE_MODEL=

# Generation
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
ARK_API_KEY=
ELEVENLABS_API_KEY=

# Login-gated or private posts: browser yt-dlp / gallery-dl read IG cookies from
IG_COOKIES_BROWSER=

# Drive (filled by: node drive-auth.mjs <CLIENT_ID> <CLIENT_SECRET>)
GDRIVE_BRANDS_FOLDER_ID=1a0XbRILE1sHHuCwmi8i6zEpi9KAeLR5w
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
