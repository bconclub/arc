{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "arc",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "goproxe",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/Users/user/Builds/goproxe",
        "run",
        "dev",
        "--",
        "-p",
        "3011"
      ],
      "port": 3011
    }
  ]
}
